---
const pains = [
  {
    icon: "network",
    title: "Sucursales desincronizadas",
    description:
      "Cada local maneja su stock por su cuenta y la información nunca coincide. Comprás de más para cubrirte, o te quedás sin producto cuando más lo necesitás.",
  },
  {
    icon: "trending",
    title: "Sin trazabilidad de stock",
    description:
      "No sabés qué entró, qué salió ni qué quedó realmente. Los errores aparecen recién cuando ya es tarde para corregirlos.",
  },
  {
    icon: "chart",
    title: "Decisiones sin datos",
    description:
      "Sin un número confiable de ventas, rotación o rentabilidad, cada decisión es una apuesta. No podés planificar el crecimiento con datos reales.",
  },
];

const icons: Record<string, string> = {
  network: `<path d="M5 12h14"/><path d="M5 6h14"/><path d="M5 18h14"/><rect x="3" y="4" width="6" height="4" rx="1"/><rect x="3" y="10" width="6" height="4" rx="1"/><rect x="3" y="16" width="6" height="4" rx="1"/>`,
  trending: `<path d="M3 3v18h18"/><path d="M18.4 9 12 15.4 8.6 12 3.4 17.2"/>`,
  chart: `<path d="M3 3v18h18"/><path d="M18.4 9 12 15.4 8.6 12 3.4 17.2"/>`,
};
---

<section class="bg-muted/60 px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center">
      <span class="badge bg-accent text-accent-foreground">El día a día</span>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        ¿Te suena familiar?
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        Así operan hoy muchos comercios y pymes que crecen. No es falta de
        esfuerzo: es que no tienen una herramienta hecha para su operación.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-3">
      {
        pains.map((pain) => (
          <div class="card items-start">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent text-accent-foreground">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[pain.icon]}
              />
            </div>
            <h3 class="text-lg font-semibold text-foreground">{pain.title}</h3>
            <p class="text-sm text-muted-foreground">{pain.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
