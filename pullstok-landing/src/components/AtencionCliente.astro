---
// Sección "Atención al cliente" como BENTO GRID con capturas REALES del
// producto (bot con IA en la tienda, bandeja de mensajes del operador,
// configuración del Asistente IA y mails transaccionales).
// Reusa el MISMO patrón visual que Features.astro: cards clickeables con
// la clase .zoom-trigger, que el lightbox <dialog> definido en Features
// engancha automáticamente para cualquier .zoom-trigger del documento.

const expand = `<path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/>`;
---

<section id="atencion" class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center">
      <span class="badge bg-accent text-accent-foreground">Atención al cliente</span>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        Tu tienda atiende sola, 24/7
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        Un bot con IA responde a tus clientes cuando vos no estás, y cuando
        hace falta una persona, te avisa. Sin perder ninguna venta.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 items-start gap-4 sm:gap-5 lg:grid-cols-6">
      <!-- ASISTENTE IA — tile grande headline (4 cols) -->
      <article class="card overflow-hidden p-0 lg:col-span-4">
        <div class="flex flex-col gap-1 p-6 pb-4">
          <div class="flex items-center gap-2">
            <span class="badge bg-accent text-accent-foreground">Asistente IA</span>
            <span class="badge bg-primary text-primary-foreground">Premium</span>
          </div>
          <h3 class="mt-1 text-xl font-bold tracking-tight text-foreground">
            Un bot con IA que responde por vos
          </h3>
          <p class="text-sm text-muted-foreground">
            Contesta a tus visitantes con la información real de tu negocio
            —productos, horarios, envíos— las 24 horas. Y si el cliente pide
            hablar con alguien, deriva la conversación a una persona.
          </p>
        </div>
        <button
          type="button"
          class="zoom-trigger group/zoom relative mt-auto block h-64 w-full cursor-zoom-in overflow-hidden rounded-t-xl border-t border-border bg-muted/40 sm:h-80"
          aria-label="Ampliar captura del bot con IA en la tienda"
        >
          <img
            src="/screenshots/mod-bot-ia.png"
            alt="Widget de chat en la tienda de Pullstok con el bot de IA respondiendo a un cliente"
            width="1440"
            height="900"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 group-hover/zoom:scale-[1.02]"
          />
          <span class="zoom-hint" aria-hidden="true" set:html={expand} />
        </button>
      </article>

      <!-- CHAT EN VIVO / HANDOFF — (2 cols) -->
      <article class="card overflow-hidden p-0 lg:col-span-2">
        <div class="flex flex-col gap-1 p-6 pb-3">
          <span class="badge w-fit bg-secondary text-secondary-foreground">Chat en vivo</span>
          <h3 class="mt-1 text-lg font-bold tracking-tight text-foreground">
            Y cuando hace falta, atendés vos
          </h3>
          <p class="text-sm text-muted-foreground">
            Chateás en vivo con tu cliente, con aviso (sonido + notificación)
            cuando alguien pide una persona. Escribiendo, visto y en línea.
          </p>
        </div>
        <button
          type="button"
          class="zoom-trigger group/zoom relative mt-auto block h-44 w-full cursor-zoom-in overflow-hidden rounded-t-xl border-t border-border bg-muted/40 sm:h-52"
          aria-label="Ampliar captura de la bandeja de mensajes del operador"
        >
          <img
            src="/screenshots/mod-chat.png"
            alt="Bandeja de mensajes del operador en Pullstok con la conversación en vivo de un cliente"
            width="1440"
            height="900"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-left-top transition-transform duration-500 group-hover/zoom:scale-[1.02]"
          />
          <span class="zoom-hint" aria-hidden="true" set:html={expand} />
        </button>
      </article>

      <!-- CONFIGURABLE SIN CÓDIGO — (2 cols) -->
      <article class="card overflow-hidden p-0 lg:col-span-2">
        <div class="flex flex-col gap-1 p-6 pb-3">
          <div class="flex items-center gap-2">
            <span class="badge bg-accent text-accent-foreground">Sin código</span>
            <span class="badge bg-primary text-primary-foreground">Premium</span>
          </div>
          <h3 class="mt-1 text-lg font-bold tracking-tight text-foreground">
            Vos le enseñás qué responder
          </h3>
          <p class="text-sm text-muted-foreground">
            Activás el bot y escribís su base de conocimiento desde el sistema.
            Sin tocar una línea de código.
          </p>
        </div>
        <button
          type="button"
          class="zoom-trigger group/zoom relative mt-auto block h-44 w-full cursor-zoom-in overflow-hidden rounded-t-xl border-t border-border bg-muted/40 sm:h-52"
          aria-label="Ampliar captura de la configuración del Asistente IA"
        >
          <img
            src="/screenshots/mod-asistente-ia.png"
            alt="Pantalla de configuración del Asistente IA en Pullstok con su base de conocimiento"
            width="1440"
            height="900"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-left-top transition-transform duration-500 group-hover/zoom:scale-[1.02]"
          />
          <span class="zoom-hint" aria-hidden="true" set:html={expand} />
        </button>
      </article>

      <!-- NOTIFICACIONES POR EMAIL — banner horizontal (4 cols) -->
      <article class="card overflow-hidden p-0 lg:col-span-4">
        <div class="grid sm:grid-cols-2">
          <div class="flex flex-col justify-center gap-1 p-6">
            <div class="flex items-center gap-2">
              <span class="badge w-fit bg-secondary text-secondary-foreground">Emails</span>
              <span class="badge bg-primary text-primary-foreground">Automático</span>
            </div>
            <h3 class="mt-1 text-lg font-bold tracking-tight text-foreground">
              Tu cliente, al tanto de todo
            </h3>
            <p class="text-sm text-muted-foreground">
              Recibe un mail cuando entra el pedido y otro cuando confirmás la
              venta, con tu marca. Sin que tengas que escribir nada: sale solo.
            </p>
          </div>
          <button
            type="button"
            class="zoom-trigger group/zoom relative block h-52 w-full cursor-zoom-in overflow-hidden border-t border-border bg-muted/40 sm:h-full sm:min-h-[13rem] sm:border-l sm:border-t-0"
            aria-label="Ampliar captura del mail transaccional"
          >
            <img
              src="/screenshots/mod-mails.png"
              alt="Mail transaccional de Pullstok avisando que se recibió el pedido del cliente"
              width="1440"
              height="900"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 group-hover/zoom:scale-[1.02]"
            />
            <span class="zoom-hint" aria-hidden="true" set:html={expand} />
          </button>
        </div>
      </article>
    </div>
  </div>
</section>
