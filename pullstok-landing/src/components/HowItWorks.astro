---
const steps = [
  {
    number: "1",
    title: "Configurá tu negocio",
    description:
      "Un wizard te guía paso a paso: datos del negocio, rubro (ferretería, indumentaria, almacén, gastronomía u otro) y categorías. En minutos quedás operativo.",
  },
  {
    number: "2",
    title: "Cargá tus productos",
    description:
      "Ingresalos a mano o importá todo de una desde un archivo Excel/CSV. Vos elegís lo que te resulte más rápido.",
  },
  {
    number: "3",
    title: "Vendé y facturá",
    description:
      "Cada venta actualiza el stock al instante y podés facturar sobre la marcha. El dashboard te muestra qué se mueve y cómo evolucionan tus números.",
  },
];

// Acento de color para cada paso (tonalidad pro, con tokens)
const stepColors = [
  "bg-primary text-primary-foreground",
  "bg-accent text-accent-foreground",
  "bg-secondary text-secondary-foreground",
];
---

<section id="como-funciona" class="bg-muted/60 px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center">
      <span class="badge bg-accent text-accent-foreground">Sin vueltas</span>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        Empezás a usarlo el mismo día
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        Sin cursos ni manuales. Pullstok te acompaña desde el primer clic.
      </p>
    </div>

    <div class="relative mt-14 grid gap-10 sm:grid-cols-3 sm:gap-6">
      {
        steps.map((step, i) => (
          <div class="relative text-center sm:text-left">
            <div
              class={`mx-auto flex h-14 w-14 items-center justify-center rounded-2xl font-display text-2xl font-bold sm:mx-0 ${stepColors[i]}`}
              aria-hidden="true"
            >
              {step.number}
            </div>
            <h3 class="mt-4 text-lg font-semibold text-foreground">
              {step.title}
            </h3>
            <p class="mt-2 text-sm text-muted-foreground">
              {step.description}
            </p>
            {i < steps.length - 1 && (
              <div
                class="absolute top-7 left-[calc(50%+2rem)] hidden h-px w-[calc(100%-4rem)] border-t-2 border-dashed border-border sm:block"
                aria-hidden="true"
              />
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
