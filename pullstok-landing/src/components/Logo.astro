---
// Logotipo nuevo de Pullstok. El SVG ya incluye el wordmark, así que este
// componente solo decide qué versión mostrar según el tema (claro/oscuro).
interface Props {
  class?: string;
}
const { class: className = "h-8 w-auto" } = Astro.props;
---

<span class={`inline-flex items-center ${className ?? "h-8 w-auto"}`}>
  <img
    src="/LogoPullNegroHor.svg"
    alt="Pullstok"
    class="h-full w-auto dark:hidden"
    width="3045"
    height="695"
  />
  <img
    src="/LogoPullBlancoHor.svg"
    alt="Pullstok"
    class="hidden h-full w-auto dark:block"
    width="3045"
    height="695"
  />
</span>
