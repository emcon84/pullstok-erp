# === Plantilla de entorno de PRODUCCIÓN ===
# Copiá este archivo a `.env.production` (o `.env`) en el VPS y completá los valores REALES.
# NUNCA commitees el archivo con valores reales: solo este .example va al repo.

# Base de datos PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL="postgresql://nexo_user:CAMBIAME@localhost:5432/nexo"

# JWT — generá uno random fuerte con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAME_POR_UNO_RANDOM_FUERTE

# Cloudflare R2 (imágenes de productos — almacenamiento S3-compatible)
# R2_ACCOUNT_ID: ID de cuenta de Cloudflare (dashboard R2 > "Account ID")
R2_ACCOUNT_ID=tu_account_id
# Credenciales del API Token de R2 (R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
# Nombre del bucket creado en R2
R2_BUCKET_NAME=tu_bucket
# URL pública del bucket (dominio público de R2 o tu CDN), sin barra final
R2_PUBLIC_URL=https://tu-bucket-publico.r2.dev

# CORS — orígenes permitidos del frontend, separados por coma (sin espacios extra)
# Incluí los dominios de la app (app.pullstok.com) y de la landing (pullstok.com,
# www.pullstok.com) porque el chatbot de la landing llama a /api/landing-chat.
CORS_ORIGINS=https://app.pullstok.com,https://pullstok.com,https://www.pullstok.com

# Servidor
PORT=5000
NODE_ENV=production

# === SMTP (mails transaccionales de la tienda online) ===
# Si estas vars faltan, el envío queda deshabilitado (no rompe el checkout ni
# la venta — solo loguea un warn). Completá con tu proveedor SMTP real.
# SMTP_SECURE=true → TLS directo (puerto 465). false → STARTTLS (puerto 587).
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
# Remitente visible en los mails (nombre + dirección)
MAIL_FROM="Pullstok <no-reply@pullstok.com>"

# === Bot IA (Groq) — chat cliente↔operador ===
# Key de PLATAFORMA usada por el bot de atención (feature PREMIUM). Si falta, el
# bot no responde (no rompe el chat — solo loguea un warn una vez). El comercio
# no la ve: es la key de Pullstok. Conseguila en https://console.groq.com/keys
# (En el futuro, BotConfig.apiKey permitirá BYO-key por comercio, encriptada.)
GROQ_API_KEY=

# === Facturación electrónica ARCA (sdd/arca-facturacion-electronica) ===
# Las URLs por defecto apuntan a los entornos oficiales de AFIP/ARCA; estas
# vars permiten override si AFIP cambia el host (solo en casos puntuales).
# Por defecto (vacías) se usan: WSAA homo/prod y WSFEv1 homo/prod.
# ARCA_WSAA_HOMO_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
# ARCA_WSAA_PROD_URL=https://wsaa.afip.gov.ar/ws/services/LoginCms
# ARCA_WSFEV1_HOMO_URL=https://wswhomo.afip.gov.ar/wsfev1/service.asmx
# ARCA_WSFEV1_PROD_URL=https://servicios1.afip.gov.ar/wsfev1/service.asmx
#
# Los CERTIFICADOS WSASS/WSFEv1 NUNCA van en la DB ni en este archivo: solo se
# guardan sus RUTAS (ArcaSetting.certPath/keyPath, configuradas por el ADMIN
# vía PUT /api/arca-settings). Convención por org en el VPS:
#   /var/www/pullstok/certs/{organizationId}/wswfev1-{HOMOLOGACION|PRODUCCION}.crt
#   /var/www/pullstok/certs/{organizationId}/wswfev1-{HOMOLOGACION|PRODUCCION}.key
#
# ARCA_E2E_CERT_DIR: SOLO para los e2e de homologación en el VPS. Apunta a la
# carpeta con wswfev1-HOMOLOGACION.crt/.key. Sin cert, ese suite se skipea.
# ARCA_E2E_CERT_DIR=/var/www/pullstok/certs/{organizationId}

# === WhatsApp Business via Kapso (sdd/whatsapp-bot) ===
# Project API key — Integrations > API Keys. Se usa para ENVIAR mensajes de
# vuelta al cliente (botones/listas) y leer historial de conversaciones.
KAPSO_API_KEY=
# Phone Number ID del número conectado de este comercio (WhatsApp > Phone numbers).
# Identifica a qué tenant llegó el mensaje entrante (ruteo número → org).
KAPSO_PHONE_NUMBER_ID=
# Secret del webhook que firma cada entrega. Se verifica contra el header
# X-Webhook-Signature (HMAC SHA256 del body CRUDO, comparación timing-safe).
# Se genera al crear el webhook en Kapso y NO debe ir commiteado.
KAPSO_WEBHOOK_SECRET=
# Base URL de la API de WhatsApp de Kapso (default, opcional).
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp
# Org destino del número de WhatsApp (fase 1: único número → 1 comercio).
# Slug de la Organization (Organization.slug @unique). El webhook la resuelve
# con basePrisma.organization.findFirst({ where: { slug, isActive: true } }).
# FASE 2: con varios números por comercio, reemplazar por tabla número→org.
KAPSO_ORG_SLUG=
