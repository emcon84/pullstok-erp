# Variables de entorno de la tienda (pullstok-tienda) — copiar a .env

# Origin de la API para los fetch SERVER-SIDE (SSR + proxies de Astro:
# storeApi.ts, /api/checkout, /api/chat/*). No se expone al browser.
# Dev: la API corre en localhost:5000.
PULLSTOK_API_URL=http://localhost:5000

# Slug del tenant a usar en local (sin wildcard DNS todavía). Ver storeApi.ts.
PULLSTOK_LOCAL_SLUG=demo

# Origin de la API para el BROWSER (socket.io del widget de chat conecta
# DIRECTO browser→API, no puede pasar por el proxy same-origin). Astro expone
# las PUBLIC_* al cliente.
# Dev: localhost:5000.
# Prod: debe ser el origin REAL de la API (ej. https://app.pullstok.com).
# IMPORTANTE: el CORS del socket en la API (CORS_ORIGINS) debe incluir el
# origin de la tienda para que la conexión sea aceptada.
PUBLIC_SOCKET_ORIGIN=http://localhost:5000
